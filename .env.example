# Copy this file to .env and fill in your own values. Never commit .env.

# Chat model. Default: free local model through Ollama.
# To swap provider, change these two lines and add that provider's key below, e.g.
#   LLM_PROVIDER=anthropic    LLM_MODEL=<model name>   ANTHROPIC_API_KEY=...
#   LLM_PROVIDER=openai       LLM_MODEL=<model name>   OPENAI_API_KEY=...
#   LLM_PROVIDER=google_genai LLM_MODEL=<model name>   GOOGLE_API_KEY=...
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0
LLM_NUM_CTX=8192

# Embedding model (used for the supplier contracts)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Pinecone free Starter plan: paste your own key here (in .env, not in this file)
PINECONE_API_KEY=
PINECONE_INDEX=invoice-contracts
